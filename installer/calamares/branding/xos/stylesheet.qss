/* X-OS installer (Calamares) — X-OS design tokens (dark). One accent: #7A8CFF. */

QWidget {
    background-color: #1A1B1E;
    color: #EDEEF0;
    font-family: "Inter", "Vazirmatn", sans-serif;
    font-size: 10.5pt;
    selection-background-color: #2E3566;
    selection-color: #FFFFFF;
}
QLabel { background: transparent; }

QPushButton {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 17px;
    padding: 7px 20px;
    min-height: 20px;
}
QPushButton:hover { background-color: #2A2C31; }
QPushButton:pressed { background-color: #212226; }
QPushButton:focus { border: 2px solid #7A8CFF; }
QPushButton:disabled { color: #6A6E77; border-color: rgba(255, 255, 255, 0.08); }
QPushButton:default {
    background-color: #2E3566;
    border: 1px solid #7A8CFF;
    font-weight: 600;
}

QLineEdit, QSpinBox, QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #212226;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px 10px;
}
QLineEdit:focus, QPlainTextEdit:focus { border: 2px solid #7A8CFF; }

QComboBox {
    background-color: #212226;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px 12px;
}
QComboBox:focus { border: 2px solid #7A8CFF; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background-color: #212226;
    border: 1px solid rgba(255, 255, 255, 0.16);
    selection-background-color: #2E3566;
    outline: 0;
}

QListView, QTreeView, QTableView {
    background-color: #212226;
    alternate-background-color: #25262A;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    outline: 0;
}
QListView::item, QTreeView::item { padding: 5px 8px; border-radius: 6px; }
QListView::item:hover, QTreeView::item:hover { background-color: #2A2C31; }
QListView::item:selected, QTreeView::item:selected { background-color: #2E3566; color: #FFFFFF; }
QHeaderView::section {
    background-color: #212226;
    color: #A0A4AC;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    padding: 6px;
}

QRadioButton, QCheckBox { spacing: 10px; background: transparent; }
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.30);
    background-color: #212226;
}
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #7A8CFF;
    border: 1px solid #7A8CFF;
}
/* Calamares applies this stylesheet application-wide, so images use absolute paths. */
QCheckBox::indicator:checked { image: url(/etc/calamares/branding/xos/check.svg); }
QRadioButton::indicator:checked { image: url(/etc/calamares/branding/xos/radio.svg); }
QRadioButton::indicator:focus, QCheckBox::indicator:focus { border: 2px solid #7A8CFF; }

QProgressBar {
    background-color: #2A2C31;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background-color: #7A8CFF; border-radius: 4px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: rgba(255, 255, 255, 0.18); border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.30); }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: rgba(255, 255, 255, 0.18); border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; }

QToolTip {
    background-color: #212226;
    color: #EDEEF0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 4px 8px;
}
QMessageBox { background-color: #212226; }

/* Partition legend: Calamares paints partition names with a hard-coded black pen and details
   in Qt::gray (PartitionLabelsView.cpp), so on the dark theme they were unreadable. Its
   background comes from the palette window colour, which is the one thing a stylesheet can
   set: a light strip keeps both lines legible. */
PartitionLabelsView {
    background-color: #E9ECEF;
}
