# X-OS live medium boot menu (generated from build/grub/grub.cfg.in)
# Labels are plain ASCII: the font built into the signed GRUB, which draws the menu under
# Secure Boot, has no dashes or bullets.
# Booting this medium never modifies internal disks. Installation is a separate,
# explicit action inside the live session.

set default=0
set timeout=5
set timeout_style=menu

serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

# X-OS graphical menu. Under Secure Boot the signed GRUB runs in lockdown mode, which refuses
# to load fonts from disk (the Inter fonts), but Debian's signed GRUB has a font built in: the
# theme then draws with that one. If no font can be loaded at all, the X-OS coloured text menu
# below is used - silently.
set menu_color_normal=light-gray/black
set menu_color_highlight=black/cyan
set xos_theme=$prefix/themes/xos
set xos_font=n
if [ "$lockdown" != "y" ] && loadfont $xos_theme/inter-18.pf2 ; then
    loadfont $xos_theme/inter-13.pf2
    loadfont $xos_theme/inter-semibold-28.pf2
    set xos_font=y
elif loadfont unicode ; then
    set xos_font=y
fi
if [ "$xos_font" = "y" ] ; then
    insmod all_video
    insmod gfxterm
    insmod png
    set gfxmode=auto
    terminal_output gfxterm serial
    set theme=$xos_theme/theme.txt
fi

insmod all_video
insmod part_gpt
insmod part_msdos
insmod iso9660

set xos_live="boot=live components live-config.username=xos live-config.hostname=x-os"

menuentry "Try X-OS without installing" --id live {
    linux /live/vmlinuz $xos_live quiet splash
    initrd /live/initrd.img
}

menuentry "Try X-OS in Lite mode (older PCs)" --id live-lite {
    linux /live/vmlinuz $xos_live xos.profile=lite quiet splash
    initrd /live/initrd.img
}

menuentry "Try X-OS with safe graphics" --id live-safe {
    linux /live/vmlinuz $xos_live nomodeset xos.profile=lite
    initrd /live/initrd.img
}

menuentry "Run X-OS from memory" --id live-toram {
    linux /live/vmlinuz $xos_live toram quiet splash
    initrd /live/initrd.img
}

menuentry "Check this computer (self-test)" --id selftest {
    linux /live/vmlinuz $xos_live xos.selftest=1 console=tty0 console=ttyS0,115200
    initrd /live/initrd.img
}

if [ "$grub_platform" = "efi" ]; then
    menuentry "Firmware settings (UEFI)" --id uefi-setup {
        fwsetup
    }
fi
