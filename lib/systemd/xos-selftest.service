[Unit]
Description=X-OS boot self-test (runs only when requested)
Documentation=file:///usr/share/doc/xos/testing.md
After=multi-user.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/xos-selftest --boot
TimeoutStartSec=900
StandardOutput=journal

[Install]
WantedBy=multi-user.target
