# X-OS boot splash (Plymouth script theme).
# Logo + three dots that brighten in turn; a password field for encrypted disks;
# status messages at the bottom. Colours: bg #0B0C0E, text #ECEEF1, accent #2BC4B0.

Window.SetBackgroundTopColor(0.043, 0.047, 0.055);
Window.SetBackgroundBottomColor(0.043, 0.047, 0.055);
W = Window.GetWidth();
H = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(W / 2 - logo.image.GetWidth() / 2, H / 2 - logo.image.GetHeight() / 2 - 40, 10);

dot_off = Image("dot.png");
dot_on = Image("dot-on.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_off);
    dots[i].SetPosition(W / 2 - 22 + i * 18, H / 2 + 50, 10);
}
frame = 0;
busy = 1;

fun refresh_callback() {
    frame++;
    active = Math.Int(frame / 18) % 3;
    for (i = 0; i < 3; i++) {
        if (busy && i == active) dots[i].SetImage(dot_on);
        else dots[i].SetImage(dot_off);
        if (busy) dots[i].SetOpacity(1); else dots[i].SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------- password (encrypted disks)
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(W / 2 - entry.image.GetWidth() / 2, H / 2 + 70, 20);
entry.sprite.SetOpacity(0);
prompt.sprite = Sprite();
bullets = 0;

fun display_password_callback(prompt_text, count) {
    busy = 0;
    entry.sprite.SetOpacity(1);
    prompt.image = Image.Text(prompt_text, 0.93, 0.93, 0.95);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(W / 2 - prompt.image.GetWidth() / 2, H / 2 + 40, 20);
    prompt.sprite.SetOpacity(1);
    for (i = 0; i < bullets; i++) bullet.sprites[i].SetOpacity(0);
    shown = count;
    if (shown > 20) shown = 20;
    for (i = 0; i < shown; i++) {
        bullet.sprites[i] = Sprite(bullet.image);
        bullet.sprites[i].SetPosition(W / 2 - shown * 8 + i * 16 + 3, H / 2 + 70 + 17, 21);
        bullet.sprites[i].SetOpacity(1);
    }
    bullets = shown;
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    busy = 1;
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; i < bullets; i++) bullet.sprites[i].SetOpacity(0);
    bullets = 0;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------------------------------------------------------------- messages
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.6, 0.63, 0.67);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(W / 2 - message.image.GetWidth() / 2, H - 80, 30);
}
Plymouth.SetMessageFunction(message_callback);
